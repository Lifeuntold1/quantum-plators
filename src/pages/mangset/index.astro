---
import Layout from '../../components/Layout.astro';
import { getProfImages } from '../../lib/data';
import { getProfImages as getProfMedia } from '../../lib/media';

const images = getProfMedia();
---

<Layout
  title="Prof. E.W. Mangset Memorial Vault | Department of Physics, University of Jos"
  description="An eternal visual legacy and memorial archive honoring Prof. E.W. Mangset, beloved professor, physicist, and mentor to the Class of 2024."
>
  <div class="flex flex-col gap-16 max-w-6xl mx-auto">
    
    <!-- Hero Tribute Header -->
    <div class="text-center max-w-3xl mx-auto flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-4 py-1 rounded-full bg-plum-600/20 border border-plum-500/40 text-plum-300 font-mono text-xs uppercase tracking-widest mb-6 shadow-md">
        <span>Head of Department (2025 — 2026) • In Memoriam</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-text">
        Prof. E.W. Mangset
      </h1>
      <p class="mt-6 text-lg sm:text-2xl font-display italic text-gold-300 font-normal max-w-2xl leading-relaxed">
        "A father, a trainer, a teacher, a mentor, and a role model."
      </p>
      <p class="mt-4 text-base sm:text-lg font-body text-muted leading-relaxed max-w-3xl">
        Prof. E.W. Mangset served devotedly as the Head of our Physics Department from 2025 until we sadly lost him in May 2026. Dedicated with love and respect by the Physics Class of 2024 in gratitude for his wonderful teaching, fatherly advice, and lasting guidance.
      </p>
      <div class="w-32 h-[2px] bg-gradient-to-r from-transparent via-gold-500 to-transparent mt-8 shadow-gold-glow"></div>
    </div>

    <!-- Editorial Photo Grid (Sourced directly from existing /assets/images/prof) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-start">
      {images.map((img, index) => (
        <div class={`rounded-2xl overflow-hidden bg-surface border border-white/[0.08] shadow-2xl group hover:border-plum-500/50 transition-all duration-500 ${
          img.filename.includes('banner') || index === 0 ? 'md:col-span-2 lg:col-span-2 aspect-[16/9]' : 'aspect-[4/5]'
        }`}>
          <div class="w-full h-full relative overflow-hidden bg-ink-950">
            <img
              src={img.metadata.src}
              alt={`Prof. E.W. Mangset archive portrait - ${img.filename}`}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <span class="font-mono text-xs text-gold-300 tracking-wider uppercase bg-ink-950/90 px-3 py-1 rounded-full border border-gold-500/30 backdrop-blur-sm">
                Memorial Photo #{index + 1}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Note -->
    <div class="p-8 rounded-2xl bg-surface/50 border border-white/[0.04] text-center max-w-2xl mx-auto">
      <p class="font-mono text-xs text-muted leading-relaxed">
        This memorial page is permanently maintained by the Class of 2024 to lovingly honor and preserve his memory.
      </p>
    </div>

  </div>
</Layout>
