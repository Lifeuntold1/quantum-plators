---
import Layout from '../../components/Layout.astro';
import { getAllGallerySectioned } from '../../lib/media';

const sections = getAllGallerySectioned();
const totalMediaCount = sections.reduce((acc, s) => acc + s.items.length, 0);
---

<Layout
  title="Complete Media Vault | Quantum Plators Physics Class of '24"
  description="Explore the full master media vault containing high-resolution memories across all events, FYB Week celebrations, and memorials for the Class of 2024."
>
  <div class="flex flex-col gap-16">
    
    <!-- Header -->
    <div class="max-w-3xl">
      <span class="text-xs font-mono uppercase tracking-widest text-gold-400">Class Photos & Memories</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-text mt-2 tracking-tight">
        Photo Gallery
      </h1>
      <p class="mt-4 text-base sm:text-lg font-body text-muted leading-relaxed">
        Explore our photos across departmental events, FYB Week celebration days, and special memorials. Currently showcasing {totalMediaCount} class photos.
      </p>
    </div>

    <!-- Sectioned Vault -->
    <div class="flex flex-col gap-14">
      {sections.map(section => (
        <section aria-label={section.title} class="rounded-3xl bg-surface border border-white/[0.08] p-6 sm:p-10">
          <div class="flex items-center justify-between pb-6 border-b border-white/[0.06] mb-8">
            <div>
              <h2 class="font-display text-2xl sm:text-3xl font-semibold text-text">{section.title}</h2>
              <span class="text-xs font-mono text-gold-400 uppercase tracking-wider mt-1 block">Date: {section.date || 'Event'}</span>
            </div>
            <span class="text-xs font-mono text-muted px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.06]">
              {section.items.length} {section.items.length === 1 ? 'Photo' : 'Photos'}
            </span>
          </div>

          {section.items.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
              {section.items.map(item => (
                <div class="aspect-square rounded-2xl overflow-hidden bg-ink-950 border border-white/[0.08] group relative">
                  <img 
                    src={item.metadata.src} 
                    alt={`${section.title} photo`} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
          ) : (
            <div class="py-10 text-center rounded-2xl bg-white/[0.01] border border-white/[0.04]">
              <p class="font-display text-lg text-text">No Photos Yet</p>
              <p class="font-mono text-xs text-muted mt-1">Photos for this event will be added soon.</p>
            </div>
          )}
        </section>
      ))}
    </div>

  </div>
</Layout>
