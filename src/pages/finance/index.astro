---
import Layout from '../../components/Layout.astro';
import { getFinance } from '../../lib/data';

const finance = await getFinance();
---

<Layout
  title="Financial Breakdown | Quantum Plators Physics '24"
  description="Transparent breakdown of the class project contributions and dinner fee for the Physics Class of 2024, University of Jos."
>
  <div class="flex flex-col gap-14 max-w-5xl mx-auto">
    
    <!-- Header -->
    <div class="max-w-3xl">
      <span class="text-xs font-mono uppercase tracking-widest text-gold-400 font-medium">Class Financial Breakdown</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-text mt-2 tracking-tight">
        Financial Breakdown
      </h1>
      <p class="mt-4 text-base sm:text-lg font-body text-muted leading-relaxed">
        A clear breakdown of our class contributions toward our ₦30,000 per-student target for class projects, graduation dinner, and legacy activities.
      </p>
    </div>

    <!-- Breakdown Category Cards -->
    <div class="flex flex-col gap-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {finance.breakdown.map((item) => {
          return (
            <div class="p-6 rounded-2xl bg-surface border border-white/[0.08] flex flex-col justify-start hover:border-gold-500/30 transition-colors shadow-lg group">
              <h3 class="font-display text-xl font-semibold text-text group-hover:text-gold-300 transition-colors">{item.category}</h3>
              <p class="text-sm font-body text-muted mt-3 leading-relaxed">{item.description}</p>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</Layout>
