---
import Layout from '../../components/Layout.astro';
import { getFybWeek } from '../../lib/data';
import { getEventDayImages } from '../../lib/media';

const fybWeek = getFybWeek();
---

<Layout
  title="Quantum Plators '24 — FYB Week Historic Recap | Physics Class of 2024"
  description="Relive the completed six-day historic celebration of FYB Week for the Department of Physics, University of Jos, Class of 2024."
>
  <div class="flex flex-col gap-20">
    
    <!-- Editorial Header (Extra Design Pass for Completed Event) -->
    <div class="text-left max-w-4xl border-l-2 border-gold-500 pl-6 sm:pl-10 py-2">
      <div class="inline-flex items-center gap-2 text-xs font-mono tracking-widest uppercase text-gold-400 mb-3">
        <span>{fybWeek.committee} • FYB Week Memories</span>
      </div>
      <h1 class="font-display text-4xl sm:text-7xl font-bold tracking-tight text-text leading-[1.08]">
        Quantum Leap <span class="text-gold-400 font-light block sm:inline">— FYB Week Recap</span>
      </h1>
      <p class="mt-6 text-base sm:text-xl font-body text-muted font-light leading-relaxed max-w-2xl">
        From July 20 to July 25, 2026, we celebrated our final week across six memorable themed days, marking the proud completion of our Physics degree at the University of Jos.
      </p>
    </div>

    <!-- Six Chronological Day Sections -->
    <div class="flex flex-col gap-16">
      {fybWeek.days.map((day, index) => {
        const photos = getEventDayImages(day.galleryFolder || '');
        
        return (
          <section aria-labelledby={`day-heading-${index}`} class="rounded-3xl bg-surface border border-white/[0.08] p-6 sm:p-12 relative overflow-hidden shadow-2xl group hover:border-white/[0.14] transition-colors">
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-radial-gold opacity-30 pointer-events-none"></div>

            <!-- Day Header & Identity -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/[0.06]">
              <div>
                <div class="flex items-center gap-3 mb-3 text-xs font-mono text-muted">
                  <span class="text-gold-400 font-bold px-3 py-1 rounded-full bg-gold-500/10 border border-gold-500/20 uppercase tracking-wider">
                    Day 0{index + 1} • {day.dayName}
                  </span>
                  <span>{day.date}</span>
                  <span class="text-white/[0.2]">•</span>
                  <span>Dress Code: {day.dressCode}</span>
                </div>
                <h2 id={`day-heading-${index}`} class="font-display text-3xl sm:text-5xl font-bold text-text tracking-tight">
                  {day.title}
                </h2>
                <p class="text-lg font-display italic text-gold-300 mt-1">
                  "{day.themeSubtitle}"
                </p>
              </div>

              <div class="text-right font-mono text-xs text-muted">
                <span>{photos.length} {photos.length === 1 ? 'Photo available' : 'Photos available'}</span>
              </div>
            </div>

            <!-- Past-Tense Recap Text (Only rendered when genuinely present per Strict Data Rule) -->
            {(day as any).recap && (
              <div class="my-8 max-w-3xl">
                <p class="font-body text-base sm:text-lg text-muted leading-relaxed">
                  {(day as any).recap}
                </p>
              </div>
            )}

            <!-- Photo Gallery or Empty-Safe Day Identity Display -->
            <div class="mt-8">
              {photos.length > 0 ? (
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                  {photos.map((photo) => (
                    <div class="rounded-2xl overflow-hidden bg-ink-950 border border-white/[0.08] aspect-[4/3] shadow-lg group-hover:shadow-xl transition-all duration-500 relative">
                      <img 
                        src={photo.metadata.src} 
                        alt={`${day.title} moment`} 
                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" 
                        loading="lazy"
                      />
                    </div>
                  ))}
                </div>
              ) : (
                /* Empty-safe layout per Strict Data Rule: identity shown without broken gallery grids or dummy placeholders */
                <div class="py-12 px-6 rounded-2xl bg-gradient-to-r from-ink-950 to-white/[0.01] border border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
                  <div>
                    <span class="font-display text-xl text-text font-semibold block">{day.title} — Photo Gallery</span>
                    <span class="font-mono text-xs text-muted mt-1 block">
                      Photos for this day will be available shortly.
                    </span>
                  </div>
                  <div class="w-12 h-12 rounded-full border border-gold-500/20 flex items-center justify-center text-gold-400/60 font-mono text-lg shrink-0">
                    ❖
                  </div>
                </div>
              )}
            </div>

          </section>
        );
      })}
    </div>

    <!-- Link out to full /gallery vault -->
    <div class="text-center py-10 border-t border-white/[0.08] mt-4">
      <span class="text-xs font-mono uppercase tracking-widest text-muted block mb-4">Looking for comprehensive event photography?</span>
      <a href="/gallery" class="inline-block px-10 py-4 rounded-full bg-gold-500 hover:bg-gold-400 text-ink-950 font-semibold text-sm transition-all shadow-lg hover:shadow-gold-glow">
        View All Class Galleries →
      </a>
    </div>

  </div>
</Layout>
