---
export const prerender = false;

import Layout from '../../components/Layout.astro';
import StudentSearch from '../../components/StudentSearch.tsx';
import { getStudents } from '../../lib/data';

const students = await getStudents();

// Format student items for the client search island
const initialStudents = students.map((s) => ({
  slug: s.slug,
  fullName: s.fullName,
  nickname: s.nickname,
  matricNumber: s.matricNumber,
  stateOfOrigin: s.stateOfOrigin,
  hobbies: s.hobbies,
  photoUrl: s.photo?.src || null,
  nominationsCount: s.nominations?.length || 0,
  isCompleteProfile: s.isCompleteProfile || false,
}));
---

<Layout
  title="Class Directory Vault | Quantum Plators Physics Class of '24"
  description="Explore all 70 verified graduating physicists from the Department of Physics, University of Jos, Class of 2024."
>
  <div class="flex flex-col gap-12 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-3xl border-l-2 border-gold-500 pl-6 sm:pl-10 py-1">
      <span class="text-xs font-mono uppercase tracking-widest text-gold-400">Class of 2024 • Official Directory</span>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-text mt-2 tracking-tight">
        Student Directory
      </h1>
      <p class="mt-4 text-base sm:text-lg text-muted font-body leading-relaxed">
        Explore our official graduating student directory! Use the search below to look up your friends, read their bios, check out their nicknames, and see their award nominations.
      </p>
    </div>

    <!-- Client Interactive Search Island -->
    <StudentSearch client:load initialStudents={initialStudents} />

    <!-- Final Exams Flier -->
    <div class="mt-8 pt-12 border-t border-gold-500/10 w-full max-w-4xl mx-auto flex flex-col items-center">
      <div class="text-center mb-8">
        <span class="text-xs font-mono uppercase tracking-widest text-gold-400">Class of 2024</span>
        <h2 class="font-display text-3xl font-bold text-text mt-2">Final Exams Wishes</h2>
      </div>
      <img src="/fliers/exam-success.webp" alt="Class of 2024 Final Exams Wishes" class="w-full rounded-2xl shadow-2xl border border-gold-500/20" loading="lazy" />
      <a href="/fliers/exam-success.webp" download="Quantum-Plators-Final-Exams-Wishes.webp" class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-full bg-gold-500/10 text-gold-400 hover:bg-gold-500 hover:text-black transition-all font-semibold border border-gold-500/30 hover:border-gold-500 hover:scale-105 active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
        Download Flier
      </a>
    </div>
  </div>
</Layout>
