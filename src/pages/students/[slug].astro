---
export const prerender = false;

import Layout from '../../components/Layout.astro';
import { getStudents } from '../../lib/data';

const { slug } = Astro.params;
const students = await getStudents();
const student = students.find((s) => s.slug === slug);

if (!student) {
  return Astro.redirect('/students');
}

const pageTitle = student.fullName 
  ? `${student.fullName} | Quantum Plators Physics '24` 
  : `${student.matricNumber || 'Student'} Profile | Quantum Plators`;

const pageDesc = student.partingWords || `Official academic roster profile for ${student.fullName || student.matricNumber}, graduating physicist from the University of Jos Class of 2024.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <div class="max-w-4xl mx-auto flex flex-col gap-12">
    
    <!-- Navigation Back -->
    <div>
      <a href="/students" class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-muted hover:text-gold-300 transition-colors font-semibold">
        <span>←</span>
        <span>Return to Class Directory</span>
      </a>
    </div>

    <!-- Main Profile Card -->
    <div class="rounded-3xl bg-surface border border-white/[0.08] overflow-hidden p-6 sm:p-12 relative shadow-2xl">
      <div class="absolute top-0 right-0 w-80 h-80 bg-radial-gold opacity-40 pointer-events-none"></div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-start relative z-10">
        
        <!-- Portrait Column (Span 5) -->
        <div class="md:col-span-5">
          {student.photo ? (
            <div class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-ink-950 border border-white/[0.1] shadow-2xl relative group">
              <img src={student.photo.src} alt={student.fullName || 'Student photo'} class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700" loading="eager" decoding="async" />
              <div class="absolute bottom-3 left-3 right-3 px-3 py-1.5 rounded-lg bg-ink-950/80 backdrop-blur-md border border-white/[0.1] text-center">
                <span class="font-mono text-[10px] uppercase tracking-widest text-gold-300 font-semibold">Verified Portrait</span>
              </div>
            </div>
          ) : (
            <div class="w-full aspect-[4/5] rounded-2xl bg-gradient-to-br from-ink-950 via-ink-900 to-surface border border-white/[0.08] flex flex-col items-center justify-center p-6 text-center shadow-inner relative overflow-hidden">
              <div class="absolute inset-0 bg-radial-gold opacity-30"></div>
              <div class="w-24 h-24 rounded-full border border-gold-500/30 flex items-center justify-center font-display text-4xl font-bold text-gold-300 mb-4 shadow-xl">
                {(student.fullName || student.matricNumber || 'Q')[0]?.toUpperCase()}
              </div>
              <span class="font-mono text-xs text-text uppercase font-semibold tracking-widest">Quantum Plators '24</span>
              <span class="font-mono text-[10px] text-gold-400 uppercase mt-1 bg-gold-500/10 px-2.5 py-1 rounded-md border border-gold-500/20">
                Photo Update Pending
              </span>
            </div>
          )}
        </div>

        <!-- Details Column (Span 7) -->
        <div class="md:col-span-7 flex flex-col gap-6">
          <div>
            <div class="flex items-center gap-3 flex-wrap mb-4">
              <span class="px-3.5 py-1.5 rounded-full bg-gold-500 text-ink-950 font-mono text-xs font-bold tracking-wider uppercase shadow-md">
                {student.matricNumber || 'PHYS/2024'}
              </span>
              <span class="px-3.5 py-1.5 rounded-full bg-white/[0.04] border border-white/[0.08] text-gold-300 font-mono text-xs">
                {student.isCompleteProfile ? '✔ Complete Profile' : '❖ Official Class Roster'}
              </span>
              {student.stateOfOrigin && (
                <span class="px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-muted font-mono text-xs">
                  📍 {student.stateOfOrigin.replace(/\s*[Ss]tate$/i, '')} State
                </span>
              )}
            </div>

            <h1 class="font-display text-3xl sm:text-5xl font-bold text-text tracking-tight leading-[1.1]">
              {student.fullName || student.matricNumber}
            </h1>

            {student.nickname && (
              <p class="font-body text-lg text-gold-400 mt-2 italic font-medium">
                "{student.nickname}"
              </p>
            )}
          </div>

          <!-- Roster Status Notification for Students awaiting full form submission -->
          {!student.isCompleteProfile && (
            <div class="p-5 rounded-2xl bg-ink-950 border border-gold-500/20 shadow-inner my-2">
              <div class="flex items-center gap-2 text-gold-400 font-mono text-xs font-semibold mb-1 uppercase tracking-wider">
                <span>Student Record Verified</span>
              </div>
              <p class="text-xs font-body text-muted leading-relaxed">
                This student is listed in our official Class of 2024 roster. Full profile details, hobbies, parting words, and photo will appear here as soon as they are submitted.
              </p>
            </div>
          )}

          <!-- Strict Data Rule: Render only fields genuinely present in sheet -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-white/[0.06]">
            {student.birthday && (
              <div>
                <span class="text-[11px] font-mono uppercase text-muted tracking-wider block">Birthday</span>
                <span class="font-body text-base font-semibold text-text mt-0.5 block">{student.birthday}</span>
              </div>
            )}
            
            {student.relationshipStatus && (
              <div>
                <span class="text-[11px] font-mono uppercase text-muted tracking-wider block">Relationship Status</span>
                <span class="font-body text-base font-semibold text-text mt-0.5 block">{student.relationshipStatus}</span>
              </div>
            )}

            {student.hobbies && (
              <div class="sm:col-span-2">
                <span class="text-[11px] font-mono uppercase text-muted tracking-wider block">Hobbies & Interests</span>
                <span class="font-body text-base text-text mt-0.5 block leading-relaxed">{student.hobbies}</span>
              </div>
            )}

            {student.shoutOut && (
              <div class="sm:col-span-2">
                <span class="text-[11px] font-mono uppercase text-muted tracking-wider block">Special Shout-out</span>
                <p class="font-body text-base text-gold-300 mt-1 bg-white/[0.02] p-4 rounded-xl border border-white/[0.06] italic leading-relaxed">
                  "{student.shoutOut}"
                </p>
              </div>
            )}

            {student.socialHandles && (
              <div class="sm:col-span-2">
                <span class="text-[11px] font-mono uppercase text-muted tracking-wider block">Social Handles</span>
                <span class="font-mono text-sm text-gold-400 font-medium mt-1 block">{student.socialHandles}</span>
              </div>
            )}
          </div>
        </div>

      </div>

      <!-- Parting Words Quote -->
      {student.partingWords && (
        <div class="mt-12 pt-8 border-t border-white/[0.08] text-center max-w-2xl mx-auto">
          <span class="text-[11px] font-mono uppercase tracking-widest text-gold-400 block mb-3">Parting Words</span>
          <blockquote class="font-display text-2xl sm:text-3xl font-medium italic text-text leading-snug">
            "{student.partingWords}"
          </blockquote>
        </div>
      )}
    </div>

    <!-- Student-Nomination Linking Section -->
    {student.nominations && student.nominations.length > 0 && (
      <div class="rounded-3xl bg-gradient-to-br from-surface via-ink-950 to-surface border border-gold-500/30 p-8 sm:p-10 shadow-2xl relative overflow-hidden">
        <div class="absolute right-0 bottom-0 w-64 h-64 bg-radial-gold opacity-20 pointer-events-none"></div>

        <div class="flex items-center gap-3 mb-6">
          <span class="w-3 h-3 rounded-full bg-gold-400 shadow-gold-glow"></span>
          <span class="font-mono text-xs uppercase tracking-widest text-gold-300 font-bold">Award Nominations</span>
        </div>
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-text mb-6">
          Nominated For
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 relative z-10">
          {student.nominations.map(nom => (
            <a href="/awards" class="p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:border-gold-500/50 transition-all duration-300 flex items-center justify-between group hover:-translate-y-1 shadow-lg">
              <div>
                <span class="font-mono text-[10px] uppercase tracking-wider text-gold-400 block mb-1">Graduation Honor</span>
                <h3 class="font-display text-2xl font-bold text-text group-hover:text-gold-300 transition-colors">{nom.categoryName}</h3>
                <span class="font-mono text-xs text-muted mt-2 inline-block bg-ink-950 px-3 py-1 rounded-md border border-white/[0.06] tabular-nums">
                  Current Tally: <strong class="text-text font-semibold">{nom.votes}</strong> {nom.votes === 1 ? 'vote' : 'votes'}
                </span>
              </div>
              <span class="text-gold-400 font-mono text-lg group-hover:translate-x-2 transition-transform duration-300">→</span>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>
</Layout>
